{
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/us-1",
      "schedule": "0 21 * * 1-5"
    },
    {
      "path": "/api/cron/us-2",
      "schedule": "0 22 * * 1-5"
    },
    {
      "path": "/api/cron/kr-1",
      "schedule": "0 7 * * 1-5"
    },
    {
      "path": "/api/cron/kr-2",
      "schedule": "0 8 * * 1-5"
    },
    {
      "path": "/api/cron/resv-us1",
      "schedule": "0 14 * * 1-5"
    },
    {
      "path": "/api/cron/resv-us2",
      "schedule": "0 15 * * 1-5"
    },
    {
      "path": "/api/cron/resv-kr1",
      "schedule": "0 0 * * 1-5"
    },
    {
      "path": "/api/cron/resv-kr2",
      "schedule": "0 1 * * 1-5"
    },
    {
      "path": "/api/cron/watch-kr",
      "schedule": "0 2 * * 1-5"
    },
    {
      "path": "/api/cron/watch-us",
      "schedule": "0 15 * * 1-5"
    }
  ],
  "functions": {
    "api/broker.js": {
      "maxDuration": 60
    },
    "api/cron/*.js": {
      "maxDuration": 60
    }
  }
}
